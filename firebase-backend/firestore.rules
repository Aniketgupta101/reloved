rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for wall catalogue; writes only via Admin SDK (Cloud Functions).
    match /items/{itemId} {
      allow read: if resource.data.publicVisibility == true;
      allow write: if false;
    }

    match /waitlistSignups/{id} {
      allow read, write: if false;
    }

    match /donorProfiles/{id} {
      allow read, write: if false;
    }

    match /donationSubmissions/{id} {
      allow read, write: if false;
    }

    match /itemRequests/{id} {
      allow read, write: if false;
    }

    match /otpCodes/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
