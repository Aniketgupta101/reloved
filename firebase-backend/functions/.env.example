# Copy this to .env.<firebase-project-alias> (e.g. .env.reloved-digital) and
# fill in real values. That file is gitignored, never commit real secrets.
# Firebase Functions loads it automatically based on the active project alias.

# --- Auth ---
# Signs/verifies our own donor/admin/partner session JWTs (routes/lib/auth.ts).
# Generate a fresh random value per environment, never reuse across dev/prod.
JWT_SECRET=

# Admin login (routes/auth.ts), email/password, checked against ONE of these:
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: bcrypt hash instead of plaintext ADMIN_PASSWORD (preferred for prod)
ADMIN_PASSWORD_HASH=

# --- Brevo (transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Numeric Brevo template IDs, see firebase-backend/README.md for what fires each.
# Leave any of these blank to fall back to a plain-text email instead of the
# branded template (nothing breaks, it just won't be styled).
BREVO_OTP_TEMPLATE_ID=
BREVO_WELCOME_TEMPLATE_ID=
BREVO_WAITLIST_WELCOME_TEMPLATE_ID=
BREVO_DONATION_CONFIRMATION_TEMPLATE_ID=
BREVO_DONATION_ADMIN_TEMPLATE_ID=
BREVO_CLAIM_CONFIRMATION_TEMPLATE_ID=
BREVO_CLAIM_ADMIN_TEMPLATE_ID=
BREVO_DONATION_DECISION_TEMPLATE_ID=
BREVO_CLAIM_DECISION_TEMPLATE_ID=
# Soft decline only — Reloved_Claim_Soft_Decline (#27). Do NOT reuse for waitlist.
BREVO_CLAIM_DECLINE_TEMPLATE_ID=
BREVO_ITEM_CLAIM_GIVER_TEMPLATE_ID=
BREVO_PARTNER_CONFIRMATION_TEMPLATE_ID=
BREVO_PARTNER_ADMIN_TEMPLATE_ID=
BREVO_CONTACT_ADMIN_TEMPLATE_ID=
BREVO_NEW_MESSAGE_ADMIN_TEMPLATE_ID=
BREVO_NEW_MESSAGE_DONOR_TEMPLATE_ID=
# Borzo/Porter delivery-stage updates — admin triggers these manually from
# Claim Requests (no Borzo API/webhooks yet, see lib/borzo.ts).
BREVO_DELIVERY_PICKED_UP_TEMPLATE_ID=
BREVO_DELIVERY_RIDER_DISPATCHED_GIVER_TEMPLATE_ID=
BREVO_DELIVERY_DELIVERED_CLAIMER_TEMPLATE_ID=
BREVO_DELIVERY_DELIVERED_GIVER_TEMPLATE_ID=
BREVO_DELIVERY_FAILED_TEMPLATE_ID=

# Where admin-alert emails (donation/claim/partner/contact) go. All four are also
# BCC'd to a second address hardcoded in lib/notifications.ts (ADMIN_BCC).
ADMIN_NOTIFY_EMAIL=

# --- MSG91 (SMS OTP widget) ---
MSG91_AUTH_KEY=
# Only needed for the non-widget server-side SMS path (rarely used, the
# client-side MSG91 widget is the primary flow, no DLT template required).
MSG91_SMS_TEMPLATE_ID=
# Alternative SMS vendor, used only if MSG91_SMS_TEMPLATE_ID isn't set.
TWO_FACTOR_API_KEY=
# If true and no real SMS vendor is configured, OTP requests log the code to
# the Functions console instead of failing outright. Never enable in prod.
OTP_VENDOR_FALLBACK_LOG=false

# --- Optional email relay (stable Brevo-allowlisted IP for OTP emails) ---
# If both are set, OTP emails route through this relay instead of calling
# Brevo directly. Leave blank to call Brevo directly.
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=

# --- Photo analysis (runs on Firebase — no Lightsail) ---
# Gemini: set GEMINI_API_KEY (Google AI Studio) OR enable Vertex AI on the
# project so the Functions service account can call gemini via ADC.
GEMINI_API_KEY=
# Optional override (default gemini-2.0-flash / gemini-2.0-flash-001 on Vertex)
GEMINI_MODEL=
VERTEX_LOCATION=us-central1
# Optional white-bg cutout via remove.bg. Without this key, Functions use
# Gemini image edit (GEMINI_IMAGE_MODEL) for a white studio background.
REMOVE_BG_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Legacy Lightsail relay (unused — kept blank so old deploys don't point at a dead host)
PHOTO_ANALYZE_RELAY_URL=
PHOTO_ANALYZE_ORIGIN=

# --- Borzo India (Business API) ---
# Test signup: https://apitest.borzodelivery.com
# Prod cabinet: https://borzodelivery.com/in
# Docs: https://borzodelivery.com/in/business-api/doc
# Leave BORZO_AUTH_TOKEN blank to fall back to manual Admin → Open Borzo.
BORZO_AUTH_TOKEN=
# Test: https://robotapitest-in.borzodelivery.com/api/business/1.8
# Prod: https://robot-in.borzodelivery.com/api/business/1.8
BORZO_API_BASE=https://robotapitest-in.borzodelivery.com/api/business/1.8
# Central ops phone on bookings (digits only, India). Example: 9653273812
BORZO_OPS_PHONE=9653273812
# Optional callback secret from Borzo Personal cabinet (Integration -> Webhooks)
# for verifying X-DV-Signature on incoming webhooks at POST /api/borzo/webhook.
BORZO_CALLBACK_SECRET=

# --- Edesy number masking (Uber/Rapido-style) — Phase 2 ---
# Portal: https://masking.edesy.in · Docs: https://edesy.in/docs/number-masking
# Create API key (starts with vp_), fund wallet (~₹1.50/min), then enable.
CALL_MASKING_ENABLED=false
EDESY_API_KEY=
# Workspace / tenant_id from masking.edesy.in (webhooks/logs; not required on API-key calls).
EDESY_TENANT_ID=
# Optional override (default https://voice-api.edesy.in/v1)
EDESY_API_BASE=https://voice-api.edesy.in/v1
# Optional display-only hint of the masked DID shown on calls (from portal/logs).
EDESY_MASKED_NUMBER_HINT=
# Public customer-care DID forwards here when someone dials the Edesy number.
CUSTOMER_CARE_FORWARD_PHONE=
# Optional HMAC secret for POST /api/edesy/inbound-route (X-Edesy-Signature).
EDESY_INBOUND_WEBHOOK_SECRET=
# Reloved legs of the bridge (ops phone rings first / Party A, then giver/claimer).
RELOVED_OPS_PRIMARY_PHONE=
# Backup (Aniket) — fallback dial if primary unset.
RELOVED_OPS_BACKUP_PHONE=

# --- Storage ---
STORAGE_BUCKET=reloved-digital-uploads

# --- Misc ---
# Base URL used in email CTA links (e.g. "Review in Dashboard").
PUBLIC_APP_URL=https://reloved-digital.web.app
# Shared secret required to call the dev-only /api/dev/seed endpoint.
SEED_SECRET=
