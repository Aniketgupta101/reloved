{
  "name": "reloved-firebase-backend",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore --project reloved-digital",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions,firestore,storage --project reloved-digital",
    "logs": "firebase functions:log",
    "seed:wall": "npm run build && node lib/scripts/seedWallSample.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "jose": "^6.2.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "typescript": "^5.8.2"
  }
}
