{
  "name": "reloved-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "prisma generate && esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external && node -e \"require('fs').copyFileSync('server/lib/bgRemovalWorker.cjs','dist/bgRemovalWorker.cjs')\"",
    "start:built": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:create-admin": "tsx prisma/createAdmin.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.18.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jose": "^6.2.9",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
