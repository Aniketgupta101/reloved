# Local Postgres, matches docker-compose.yml. Port 55432 (not the default
# 5432) to dodge a native Postgres service already bound to 5432 on Windows.
DATABASE_URL="postgresql://reloved:reloved@localhost:55432/reloved"

PORT=8787
NODE_ENV=development

# Signs admin session tokens (server/lib/auth.ts). Generate a fresh random
# value per environment — e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=""

# "disk" for local dev (default). "gcs" once deployed to Cloud Run, since
# local disk doesn't survive a redeploy there — see Docs/BACKEND_PLAN.md.
STORAGE_DRIVER="disk"
# Required only when STORAGE_DRIVER=gcs. On Cloud Run, auth is automatic via
# the service's runtime service account (needs Storage Object Admin on this
# bucket) — no key file needed.
GCS_BUCKET_NAME=""

# Frontend's Firebase project ID (public value, from frontend/firebase-applet-config.json).
# Only used if a Firebase ID token shows up on /api/admin/* (secondary/fallback
# path — see server/middleware/adminAuth.ts). Primary admin login is
# JWT_SECRET-based against the profiles table, not Firebase.
FIREBASE_PROJECT_ID=""

# MSG91 — SMS/OTP only (India DLT compliance). See Docs/BACKEND_PLAN.md
# "Email + SMS" section for why. Leave unset for local dev: OTP codes just
# get logged to the console instead of sent.
MSG91_AUTH_KEY=""
MSG91_SMS_TEMPLATE_ID=""

# 2Factor — alternate SMS/OTP vendor, only used when MSG91_AUTH_KEY above is
# unset. Free trial credits, no DLT registration needed for OTP-category
# SMS, easier to spin up for local testing than MSG91.
TWO_FACTOR_API_KEY=""

# Brevo — transactional + broadcast email. Leave unset for local dev: emails
# just get logged to the console instead of sent.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@reloved.org"
BREVO_SENDER_NAME="reloved"
# Brevo template ID for donor OTP emails (Campaigns → Templates → Email).
# Leave unset to fall back to a plain inline email instead.
BREVO_OTP_TEMPLATE_ID=""

# Gemini — powers admin bulk-upload's category/title/description suggestions
# (server/lib/gemini.ts). Leave unset for local dev: returns a stub
# suggestion so the flow is still testable without a real key.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Where operator notifications go — a new donation submission or claim
# request fires an email here so admins don't rely on manually checking the
# dashboard. Leave unset to skip silently (no error, just no notification).
ADMIN_NOTIFY_EMAIL=""

# When "true", /api/donations rejects submissions whose phone hasn't
# completed /api/otp/verify in the last 30 minutes. Default off so local
# dev/testing isn't blocked before MSG91 is configured.
REQUIRE_OTP_FOR_DONATIONS="false"

# Set to "true" only in local dev if Firebase Email/Password sign-in isn't
# enabled yet and you need to test /admin without a real login. Ignored
# whenever NODE_ENV=production. Leave unset/false otherwise.
DEV_ADMIN_BYPASS="false"
