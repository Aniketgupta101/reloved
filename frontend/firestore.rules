rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public items collection
    match /items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Public donation submissions
    match /donation_submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Partner Applications
    match /partner_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Contact Messages
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Additional operational collections
    match /partners/{id} { allow read, write: if true; }
    match /partner_needs/{id} { allow read, write: if true; }
    match /allocations/{id} { allow read, write: if true; }
    match /allocation_items/{id} { allow read, write: if true; }
    match /evidence_records/{id} { allow read, write: if true; }
    match /profiles/{id} { allow read, write: if true; }
    match /audit_events/{id} { allow read, write: if true; }
    match /app_settings/{id} { allow read, write: if true; }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
